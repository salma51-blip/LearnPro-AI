          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["due", "scheduled", "mastered"]
        },
        "nextReviewAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "subject", "topicTitle", "stageIndex", "intervalDays", "retentionScore", "rememberedCount", "forgottenCount", "status", "nextReviewAt", "createdAt", "updatedAt"]
    },
    "AssignedPlan": {
      "title": "AssignedPlan",
      "description": "Teacher-assigned lesson or assessment task in the student's daily plan.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Science", "English", "Humanities", "Computing"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "topicTitle": {
          "type": "string",
