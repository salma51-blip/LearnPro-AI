          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "questionPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "studentAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "correctAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "misunderstanding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "simpleExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
