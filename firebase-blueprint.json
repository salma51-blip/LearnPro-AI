        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "textbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Science", "English", "Humanities", "Computing"]
        },
        "chapterTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "pageNumber": {
          "type": "integer"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "embedding": {
          "type": "array"
        },
        "sharedWithClassroom": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "textbookId", "subject", "chapterTitle", "topicTitle", "pageNumber", "content", "embedding", "createdAt"]
    },
    "VisualLesson": {
      "title": "VisualLesson",
      "description": "Interactive visual learning experience grounded in textbook citations.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Science", "English", "Humanities", "Computing"]
        },
        "textbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
