      "required": ["ownerId", "subject", "title", "topicTitle", "itemType", "status", "dueDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Student learning profile and workspace preferences."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly private user PII (email, display name)."
    },
    "/textbooks/{textbookId}": {
      "schema": { "$ref": "#/entities/Textbook" },
      "description": "Uploaded PDF textbooks organized by subject."
    },
    "/textbooks/{textbookId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/TextbookChapter" },
      "description": "Extracted chapters and topics belonging to a textbook."
    },
    "/textbooks/{textbookId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/TextbookChunk" },
      "description": "RAG vector chunks belonging to a textbook."
    },
    "/visualLessons/{lessonId}": {
      "schema": { "$ref": "#/entities/VisualLesson" },
      "description": "Interactive visual learning experiences per topic."
    },
    "/tutorSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TutorSession" },
      "description": "Adaptive AI tutor sessions."
    },
    "/tutorSessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/TutorMessage" },
      "description": "Conversation messages inside a tutor session."
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/Assessment" },
      "description": "Continuous written and handwritten assessments."
    },
    "/mistakes/{mistakeId}": {
      "schema": { "$ref": "#/entities/MistakeRecord" },
      "description": "Tracked mistakes, misunderstandings, and remediation drills."
    },
    "/revisions/{revisionId}": {
      "schema": { "$ref": "#/entities/RevisionItem" },
      "description": "Spaced-repetition memory retention schedule."
    },
    "/assignedPlans/{planId}": {
      "schema": { "$ref": "#/entities/AssignedPlan" },
      "description": "Teacher-assigned daily learning plan tasks."
    }
  }
}
