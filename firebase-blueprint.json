    },
    "TutorSession": {
      "title": "TutorSession",
      "description": "Adaptive AI tutor session anchored to a subject and topic.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Science", "English", "Humanities", "Computing"]
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "textbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "messageCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "subject", "topicTitle", "textbookId", "messageCount", "createdAt", "updatedAt"]
    },
    "TutorMessage": {
      "title": "TutorMessage",
      "description": "Individual message inside an adaptive AI tutor session.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["student", "tutor"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "citations": {
          "type": "array"
        },
        "checkQuestion": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "sessionId", "role", "content", "createdAt"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Continuous written assessment (digital or handwritten photo OCR evaluation).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Science", "English", "Humanities", "Computing"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "assessmentType": {
          "type": "string",
          "enum": ["topic", "daily", "weekly", "chapter", "revision", "cumulative"]
        },
        "chapterTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "topicTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "mode": {
          "type": "string",
          "enum": ["digital", "handwritten"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "needs_review", "graded"]
        },
        "questions": {
          "type": "array"
        },
        "evaluation": {
          "type": "object"
        },
        "score": {
          "type": "integer"
        },
        "maxScore": {
          "type": "integer"
        },
        "teacherNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "handwrittenPreview": {
          "type": "string",
          "maxLength": 350000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "subject", "title", "assessmentType", "chapterTitle", "topicTitle", "mode", "status", "questions", "score", "maxScore", "createdAt", "updatedAt"]
    },
