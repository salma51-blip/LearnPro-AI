{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Student learning profile and active workspace state (PII isolated to private subcollection).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "grade": {
          "type": "string",
          "enum": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5"]
        },
        "curriculum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "viewMode": {
          "type": "string",
          "enum": ["student", "teacher", "parent"]
        },
        "streakDays": {
          "type": "integer"
        },
        "masteryPoints": {
          "type": "integer"
        },
        "readingScore": {
          "type": "integer"
        },
        "independentScore": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "studentName", "grade", "curriculum", "viewMode", "streakDays", "masteryPoints", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly owner-isolated PII for authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Textbook": {
      "title": "Textbook",
      "description": "Uploaded PDF textbook metadata and syllabus summary.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
          "enum": ["Mathematics", "Science", "English", "Humanities", "Computing"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "grade": {
          "type": "string",
          "enum": ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5"]
        },
        "pageCount": {
          "type": "integer"
        },
        "chunkCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["ready", "processing", "error"]
        },
        "sharedWithClassroom": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "subject", "title", "grade", "pageCount", "chunkCount", "status", "createdAt", "updatedAt"]
    },
    "TextbookChapter": {
      "title": "TextbookChapter",
      "description": "Structured chapter and topic breakdown extracted from a textbook.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "textbookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "pageStart": {
          "type": "integer"
        },
        "pageEnd": {
          "type": "integer"
        },
        "topics": {
          "type": "array"
        },
        "sharedWithClassroom": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "textbookId", "chapterNumber", "title", "summary", "pageStart", "pageEnd", "topics", "createdAt"]
    },
    "TextbookChunk": {
      "title": "TextbookChunk",
      "description": "Indexed textbook passage with page citation and vector embedding for RAG retrieval.",
