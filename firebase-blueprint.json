        },
        "storyIntro": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "lessonPayload": {
          "type": "object"
        },
        "completed": {
          "type": "boolean"
        },
        "comprehensionScore": {
          "type": "integer"
        },
        "sharedWithClassroom": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
