      "required": ["ownerId", "subject", "topicTitle", "questionPrompt", "studentAnswer", "correctAnswer", "misunderstanding", "simpleExplanation", "visualHint", "practiceQuestion", "practiceAnswer", "resolved", "occurrenceCount", "createdAt", "updatedAt"]
    },
    "RevisionItem": {
      "title": "RevisionItem",
      "description": "Spaced-repetition memory retention item (Immediate, 1d, 3d, 7d, 15d).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subject": {
          "type": "string",
